# Copy to .env and adjust.

# Devices (run `python scripts/check_devices.py` to find them)
CAMERA_INDEX=0                 # AVFoundation index of the Logitech webcam
MIC_NAME=                      # substring of the input device name, e.g. Logitech; empty = system default

# Signing
PRECISE_THRESHOLD=0.3          # sign probability below this = "not sure, pick" (ER vocabulary)
# Natural signing is disabled for now (see medbridge/server.py), so these have no effect:
# DEFAULT_MODE=natural           # natural | precise
# NATURAL_POSE_MODE=lightweight  # rtmlib Wholebody: lightweight | balanced | performance
# NATURAL_MIN_SCORE=-0.65        # free translation: beam score below this = "low confidence"
# PHRASE_MIN_SCORE=-1.5          # ER phrase bank: top phrase score below this = "low confidence"
# REST_LINE=0.85                 # natural mode: hands below this fraction of frame height count as resting

# Precise mode: sign labels -> English
GLOSS_TRANSLATOR=literal       # literal | llm
ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=           # or `ant auth login`; any failure falls back to literal

# Doctor -> patient signing figure
SIGNING=1                      # 0 = captions only
SIGN_MT=1                      # 1 = words missing from the local sign dictionary are fetched from sign.mt (sends those words); 0 = local only

# Doctor speech-to-text: whisper = on this Mac (default) | elevenlabs = final captions from ElevenLabs Scribe.
# With elevenlabs, the audio of each thing the doctor says is sent to ElevenLabs (needs ELEVENLABS_API_KEY below).
# Whisper still writes the live text while the doctor speaks, and takes over if the cloud call fails.
ASR_ENGINE=whisper

# Loudness gate for a noisy room. 1 = mic sound quieter than MIC_GATE_DB counts as silence, so people talking further
# away neither start a caption nor keep one open. Works best with a mic close to the doctor (clip-on or headset).
# 0 = off: everything the voice detector calls speech is used, as before.
# Find a value with `python scripts/check_devices.py --calibrate`.
MIC_GATE=0
MIC_GATE_DB=-40

# Patient's voice (optional): each confirmed patient message is spoken on the doctor view through ElevenLabs.
# With a key set, the text of those messages is sent to ElevenLabs. Leave the key empty to keep it off.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # "George"; any voice id from your ElevenLabs account
ELEVENLABS_MODEL=eleven_flash_v2_5         # their fastest model

# Server
HOST=0.0.0.0                   # 0.0.0.0 lets a second Mac open /doctor over the LAN
PORT=8000
PATIENT_LAN=0                  # 1 = also serve camera stream + patient controls to other machines
METRICS_LOG=0                  # 1 = write timings/scores/labels (no text, audio or video) to data/metrics.jsonl
